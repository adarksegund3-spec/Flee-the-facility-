local function findroot_or(char, wantHumanoid)
    if not (char and char.Parent) then return end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    return wantHumanoid and hum or hrp
end
local LPH, LPR = findroot_or(LPC, true), findroot_or(LPC)
LP.CharacterAdded:Connect(function(c)
    repeat SRunService.Heartbeat:Wait()
        LPC, LPH, LPR = c, findroot_or(c, true), findroot_or(c)
    until LPC and LPH and LPR
end)
local function find_instance(it, was)
    local l = typeof(it)
    if l == 'Instance' then
        local a = it:FindFirstChild(was, true)
        if a then return a, true end
        for _, b in pairs(it:GetDescendants()) do
            if b.Name:lower() == was:lower() then return b, true end
        end
    end
    return nil, false
end
local function GetCurrentMap()
    local ov = find_instance(ReplicatedStorage, "CurrentMap")
    if ov and ov:IsA("ObjectValue") and ov.Value then return ov.Value end
    local comp = find_instance(SWorkspace, "ComputerTable")
    if comp and comp.Parent then return comp.Parent end
    local pod = find_instance(SWorkspace, "FreezePod")
    if pod and pod.Parent then return pod.Parent end
end
local function GetPlayerList()
    local t = {}
    for _, p in pairs(SPlayers:GetPlayers()) do
        if p ~= LP then insert(t, p.Name) end
    end
    return t
end
local function ToNumV(v)
    if c_type("number", v) then return v end
    local n = t_num(v); return n or 0
end
