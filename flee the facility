UI:CreateToggle(MainTab.Frame, "ESP Jogador", false, function(v)
    Genv.SHub.Toggle.PEspEnable = v
    local conn
    local espFolder = Instance.new("Folder")
    espFolder.Name = "SHub_ESP_Player"
    espFolder.Parent = ScreenGui
    local function clear()
        for _, c in pairs(espFolder:GetChildren()) do c:Destroy() end
        for _, p in pairs(SPlayers:GetPlayers()) do
            if p ~= LP and p.Character then
                local h = p.Character:FindFirstChild("S_Highlight")
                if h then h:Destroy() end
            end
        end
    end
    local function update()
        for _, c in pairs(espFolder:GetChildren()) do
            if not c.Adornee or not c.Adornee.Parent then c:Destroy() end
        end
        for _, p in pairs(SPlayers:GetPlayers()) do
            if p ~= LP and p.Character then
                local head = p.Character:FindFirstChild("Head")
                local root = findroot_or(p.Character)
                if not (head and root) then continue end
                local existing = espFolder:FindFirstChild(p.Name)
                if not existing then
                    local bb = Instance.new("BillboardGui")
                    bb.Name = p.Name
                    bb.Adornee = head
                    bb.Size = UDim2.new(5, 0, 5, 0)
                    bb.AlwaysOnTop = true
                    bb.Parent = espFolder
                    local l = Instance.new("TextLabel", bb)
                    l.Size = UDim2.fromScale(1, 1)
                    l.BackgroundTransparency = 1
                    l.Font = Enum.Font.GothamBold
                    l.TextSize = 11
                    l.TextStrokeTransparency = 0.3
                    l.TextColor3 = Color3.fromRGB(255, 255, 255)
                    l.Text = p.Name
                else
                    existing.Adornee = head
                    local l = existing:FindFirstChildOfClass("TextLabel")
                    if l then
                        l.Text = string.format("%s [%d]", p.Name, math.floor((root.Position - LPR.Position).Magnitude))
                    end
                end
                local hl = p.Character:FindFirstChild("S_Highlight")
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "S_Highlight"
                    hl.Adornee = p.Character
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.6
                    hl.Parent = p.Character
                end
            end
        end
    end
    if v then
        conn = SRunService.RenderStepped:Connect(function() pcall(update) end)
    else
        if conn then conn:Disconnect() end
        clear()
    end
end)

